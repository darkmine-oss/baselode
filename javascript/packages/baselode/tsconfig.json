{
  "compilerOptions": {
    /* Declaration-only emit from plain JS + JSDoc.
       TypeScript never touches the JS output — Vite owns that.
       This config exists solely to generate dist/**\/*.d.ts. */

    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "rootDir": "src",

    /* JSX support for .jsx files */
    "jsx": "react-jsx",

    /* Resolve '.js' extension imports as TypeScript does for bundlers */
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2020",

    /* Avoid errors from untyped third-party peer deps (three, plotly, etc.) */
    "skipLibCheck": true,
    "noEmitOnError": false,
    "strict": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
