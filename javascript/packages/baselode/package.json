{
  "name": "baselode",
  "version": "0.1.11",
  "description": "Geoscience drillhole data processing and visualization toolkit",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkmine-oss/baselode.git",
    "directory": "javascript/packages/baselode"
  },
  "homepage": "https://github.com/darkmine-oss/baselode",
  "bugs": {
    "url": "https://github.com/darkmine-oss/baselode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/baselode.js",
  "module": "./dist/baselode.js",
  "exports": {
    ".": {
      "import": "./dist/baselode.js"
    },
    "./style.css": "./dist/style.css",
    "./tool-ui": {
      "types": "./types/tool-ui.d.ts",
      "import": "./dist/tool-ui.js"
    },
    "./tool-ui/contracts": {
      "types": "./types/tool-ui-contracts.d.ts",
      "import": "./dist/tool-ui-contracts.js"
    },
    "./assistant-ui": {
      "types": "./types/assistant-ui.d.ts",
      "import": "./dist/assistant-ui.js"
    },
    "./tool-ui/style.css": "./src/tool-ui/style.css"
  },
  "files": [
    "dist",
    "src/tool-ui/style.css",
    "types",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "version:from-tag": "node ./scripts/set-version-from-tag.mjs",
    "build": "vite build",
    "build:module": "vite build --config vite.standalone.js && cp dist/baselode-module.js ../../../demo-viewer-dash/assets/baselode-module.js",
    "prepack": "npm run version:from-tag && npm run build",
    "pack:check": "npm pack --dry-run",
    "publish:npm": "npm publish",
    "publish:npm:provenance": "npm publish --provenance",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:types": "tsc --project tests/types/tsconfig.json",
    "test:package": "node scripts/check-package-contracts.mjs",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@assistant-ui/react": ">=0.15.0 <0.16.0",
    "papaparse": ">=5.0.0",
    "plotly.js-dist-min": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.150.0",
    "three-viewport-gizmo": ">=2.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  }
}
