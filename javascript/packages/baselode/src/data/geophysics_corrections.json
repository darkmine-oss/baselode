                      ]
                    }
                  },
                  {
                    "required": [
                      "model"
                    ],
                    "properties": {
                      "correction": {
                        "const": "magnetic_igrf"
                      },
                      "parameters": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "channel",
                          "event_id",
                          "evidence",
                          "model"
                        ],
                        "properties": {
                          "channel": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                          },
                          "event_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "model": {
                            "const": "IGRF14"
                          }
                        }
                      }
                    },
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "base_binding"
                          ]
                        },
                        {
                          "required": [
                            "base_station_id"
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "parameters"
                      ]
                    },
                    {
                      "required": [
                        "base_binding"
                      ]
                    },
                    {
                      "required": [
                        "base_station_id"
                      ]
                    },
                    {
                      "required": [
                        "affected_records"
                      ]
                    },
                    {
                      "required": [
                        "model"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
