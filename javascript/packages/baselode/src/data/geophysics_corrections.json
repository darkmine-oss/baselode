                          "base_channel",
                          "reference",
                          "max_gap",
                          "event_id",
                          "evidence",
                          "clock_policy"
                        ],
                        "properties": {
                          "channel": {
                            "type": "string"
                          },
                          "base_channel": {
                            "type": "string"
                          },
                          "reference": {
                            "type": "number",
                            "minimum": -1e+100,
                            "maximum": 1e+100
                          },
                          "max_gap": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 1e+100
                          },
                          "event_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "evidence": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
