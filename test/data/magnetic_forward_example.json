{
  "schema": "baselode.geophysics.magnetic_forward_request",
  "version": 1,
  "coordinate_frame": {
    "id": "synthetic-local-grid",
    "kind": "local_cartesian",
    "axes": "x_y_up",
    "units": "m",
    "height_datum": "local_zero"
  },
  "sources": [
    {
      "id": "dipole",
      "kind": "dipole",
      "x_m": 0,
      "y_m": 0,
      "z_m": -100,
      "moment_x_A_m2": 0,
      "moment_y_A_m2": 0,
      "moment_z_up_A_m2": 1000
    }
  ],
  "points": [
    {
      "id": "surface",
      "x_m": 0,
      "y_m": 0,
      "z_m": 0
    }
  ],
  "include_sensitivities": true,
  "min_distance_m": 1,
  "background_nT": {
    "x": 0,
    "y": 0,
    "z_up": 50000
  },
  "metadata": {
    "purpose": "Synthetic magnetic dipole, independent of measured survey data"
  }
}
