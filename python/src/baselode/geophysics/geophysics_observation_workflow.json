            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        "required": [
          "channels",
          "radius",
          "duplicate_policy",
          "elevation_policy",
          "bounds",
          "shape"
        ]
      },
      "inputs": [
        "observations"
      ],
      "outputs": {
        "grid": "raster",
        "support": "raster",
        "neighbor_count": "raster",
        "nearest_distance": "raster",
        "extrapolation": "raster",
        "report": "report"
