    {
      "id": "grid_observations",
      "version": 1,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1e+100
