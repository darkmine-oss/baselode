            },
            "operation": {
              "enum": [
                "qc_observations",
                "inspect_corrections",
                "declare_corrections",
                "correct_magnetic_base",
                "remove_igrf",
                "correct_magnetic_lag",
                "correct_magnetic_heading",
                "reproject_observations",
                "analyze_crossovers",
                "level_magnetic_lines",
                "grid_observations",
                "raster_low_pass",
                "raster_high_pass",
                "raster_band_pass",
                "raster_vertical_derivative",
                "raster_horizontal_derivative",
                "raster_total_horizontal_derivative",
                "raster_tilt_derivative",
                "raster_analytic_signal",
                "raster_upward_continuation",
                "raster_reduce_to_pole",
                "raster_combine",
                "remove_normal_gravity",
                "apply_gravity_tide",
                "correct_gravity_drift",
                "analyze_gravity_repeats",
                "analyze_grid_spectrum"
              ]
            },
            "version": {
              "const": 1
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "input"
                    ],
                    "properties": {
                      "input": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "step",
                      "output"
                    ],
                    "properties": {
                      "step": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                      },
                      "output": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                      }
                    }
                  }
                ]
              }
            },
            "parameters": {
              "type": "object"
            }
          }
        }
      },
      "outputs": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 32,
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input"
              ],
              "properties": {
                "input": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "output"
              ],
              "properties": {
                "step": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "output": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                }
              }
            }
          ]
        }
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema"
