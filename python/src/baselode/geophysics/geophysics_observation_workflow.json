                "bias_nT": {
                  "type": "number",
                  "minimum": -1e+100,
                  "maximum": 1e+100
                }
              }
            }
          },
          "max_heading_gap": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 180
          },
          "bias_convention": {
            "const": "observed_minus_reference"
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
