    "max_result_nodes": 2000000,
    "max_input_depth": 32,
    "max_result_depth": 33,
    "max_input_bytes": 16777216,
    "max_result_bytes": 33554432,
    "max_metadata_budget_units": 131072,
    "metadata_numeric_scalar_units": 32,
    "minimum_nonzero_covariance_entry_cps2": 1e-200,
    "covariance_rounding_relative_tolerance": 1.1368683772161603e-13
  },
  "correction_order": [
    "live_time_normalization",
    "calibrated_window_selection",
    "reference_air_height",
    "background_subtraction",
    "height_adjusted_stripping",
    "nominal_height_normalization",
    "sensitivity_conversion",
    "conditional_covariance_propagation"
  ],
  "conventions": {
    "energy": "E_keV=offset_keV+gain_keV_per_channel*zero_based_index; windows inclusive first, exclusive last, complete bins; reported edges at centre +/-half bin",
    "equivalent_height": "h_eff=h_AGL*(P/P_ref)*(T_ref_K/T_K); all height-dependent calibration uses same reference dry air",
    "response": "net_window_cps=S(h_eff)*stripped_cps; S=S0+(h_eff-h0)*slopes",
    "concentration": "diag(exp(mu*(h_eff-h0))/sensitivity)*inverse(S)*net_window_cps",
    "covariance": "positive factors for diag(window_counts/live^2), independent cosmic rank1, supplied aircraft/radon PSD covariance, propagated through same linear transform",
    "PSD_rounding": "scale-normalised diagonal-pivoted Cholesky; preserve positive pivots, nonpositive residual block within64eps may be truncated; adjustments/rank retained, reconstruction <=512eps relative"
  },
  "assumptions": [
    "Explicit raw state, calibration identities and UTC acquisition validity; no current-clock expiry or inferred detector constants",
    "Supplied fixed energy calibration; no drift fitting, fractional rebinning, NASVD/MNF or radon estimator",
    "Cosmic monitor and supplied radon noise independent of main spectrum and each other; aircraft/background estimates independent of counts",
    "Conditional independent Poisson plug-in variance with fixed live times; no renewal dead-time variance model, confidence intervals or posterior claim",
    "Calibration, energy/height/exposure uncertainty and cross-record covariance excluded; shared background calibration may correlate records",
    "Calibrated flat infinite-source exponential height model, geometric/effective heights50..250m and declared subsets; not rugged-terrain or footprint inversion",
    "Negative estimates retained with flags; zero-count plug-in variance is not evidence of certainty; eU/eTh do not establish secular equilibrium",
    "Metadata structural units: UTF8 JSON strings/keys/punctuation and bool/null normally, fixed32 per numeric scalar; enclosing byte/node limits also apply"
  ],
  "references": [
    {
      "title": "IAEA-TECDOC-1363 (2003), sections5.5.3,5.5.5-9 and5.6",
      "url": "https://www-pub.iaea.org/MTCD/Publications/PDF/te_1363_web.pdf"
    }
  ]
}
