  "execution": {
    "python": true,
    "javascript": false,
    "installation": "pip install 'baselode[potential-fields]' (Harmonica 0.7.0); plate calculation/application needs only core dependencies"
  },
  "assumptions": [
    "Positive land density is supplied in kg/m3, not inferred; land thickness and terrain heights are above the explicit reference level.",
    "Bouguer effect 2*pi*G*rho*(z-reference) is subtracted from a gravity disturbance. No free-air term or height/geoid conversion is applied.",
    "Terrain correction is minus downward gravity from signed prisms between station height and each DEM cell; add to plate-reduced disturbance.",
    "Finite north-up DEM cells are constant-height footprints. Outside the rectangular support terrain is explicitly assumed flat at each station height; this is a finite-zone approximation.",
    "Ground observation height must match its containing DEM cell within the explicit tolerance; no airborne/marine/curvature or adaptive far-zone model.",
    "Density sensitivity is the exact derivative of the linear reduction with respect to supplied density; it is not propagated uncertainty.",
    "Python numerical execution; JavaScript exposes shared contracts and bound history/reprojection replay."
  ],
  "references": [
    "https://www.fatiando.org/harmonica/v0.7.0/api/generated/harmonica.bouguer_correction.html",
    "https://www.fatiando.org/harmonica/v0.7.0/api/generated/harmonica.prism_gravity.html",
    "https://pubs.usgs.gov/of/2001/of01-503/of01-503.pdf",
    "https://developer.seequent.com/docs/guides/geophysics-tasks/tasks/gravity-terrain-correction/"
  ],
  "binding": {
    "algorithm": "baselode.gravity_topography_binding.v1",
    "canonical": "Registered ASCII-key objects sorted into key/value arrays; binary64 numbers encoded [f64,big-endian-hex] with signed zero normalized; arrays ordered. SHA-256 JSON UTF-8 compact encoding of [algorithm,canonical(parameters except event_id/evidence),canonical(model),canonical(context),canonical(record id/z arrays)]. Context includes historical CRS/units/local frame, height datum/m/up, effective channel gravity datum and tide system. XY/readings are covered by the native input/output binding chain; historical XY is not recalculated from rounded inverse projections. Geometric support is checked at native execution, and historical CRS is replayed through explicit reprojection events."
  },
