    "gravitational_constant_units": "m^3/(kg*s^2)",
    "potential_convention": "negative_zero_at_infinity",
    "acceleration_convention": "minus_gradient_potential",
    "summation": "neumaier_compensated",
    "sensitivity": "fixed_geometry_density",
    "backend": "harmonica",
    "backend_version": "0.7.0",
    "kernel_backend": "choclo",
    "kernel_backend_version": "0.3.2"
